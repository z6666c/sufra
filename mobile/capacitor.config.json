{
  "appId": "sa.sufra.app",
  "appName": "سُفرة",
  "webDir": "www",
  "backgroundColor": "#142019",
  "appendUserAgent": "SufraApp/1.0",
  "server": {
    "url": "https://sufra.vercel.app",
    "allowNavigation": ["sufra.vercel.app"],
    "errorPath": "offline.html"
  },
  "ios": { "contentInset": "automatic", "scheme": "SufraApp" },
  "android": { "allowMixedContent": false },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 1200, "launchAutoHide": true, "backgroundColor": "#142019", "showSpinner": false },
    "StatusBar": { "overlaysWebView": false, "backgroundColor": "#142019", "style": "DARK" }
  }
}
