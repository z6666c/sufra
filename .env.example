# كلها اختيارية: التطبيق يعمل بدونها، وتفعّل ميزات إضافية عند ضبطها

# تحسين أوصاف الأصناف وترجمتها (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# توليد صور الأطباق (Recraft)
RECRAFT_API_KEY=
RECRAFT_MODEL=recraftv3

# تخزين المنيو المنشور:
# على Vercel أو أي استضافة بلا قرص دائم: Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# على خادم خاص: مجلد ملفات JSON (الافتراضي .data/menus)
MENU_STORAGE_DIR=

# رابط موقعك العام لروابط QR (مثال: https://menu.example.sa)
PUBLIC_BASE_URL=

# ── الحسابات (حساب إدارة + حساب ديمو) ──
# مفتاح توقيع الجلسات — إلزامي في الإنتاج (32 حرفاً عشوائياً على الأقل): openssl rand -base64 32
AUTH_SECRET=
# حساب الإدارة — في الإنتاج لا يعمل إلا إذا ضبطت ADMIN_PASSWORD
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# الوضع العام: التطبيق مفتوح لأي زائر كحساب ديمو بدون تسجيل (false = يتطلب الدخول)
PUBLIC_DEMO=true
# حساب الديمو — يظهر في صفحة الدخول للتجربة (بدون استهلاك الذكاء المدفوع)
DEMO_ENABLED=true
DEMO_USERNAME=demo
DEMO_PASSWORD=demo1234
# موديل Recraft المتجهي (يجب أن ينتهي بـ _vector)
RECRAFT_LOGO_MODEL=recraftv3_vector
# الذكاء الاصطناعي في الديمو العام (false لإيقافه) وحدوده لكل زائر بالساعة
DEMO_AI=true
DEMO_AI_LOGOS_PER_HOUR=3
DEMO_AI_IDENTITIES_PER_HOUR=5

# ── حسابات العملاء (التسجيل قبل الدفع) ──
# قاعدة البيانات: اربط Upstash Redis من Vercel ← Storage (يضيف KV_REST_API_URL و KV_REST_API_TOKEN تلقائياً)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# مدة حفظ المسودة غير المدفوعة (أيام)
DRAFT_DAYS=7
# ── الباقات (ريال) ──
NEXT_PUBLIC_PRICE_ONCE=132
NEXT_PUBLIC_PRICE_MONTHLY=29
# مدة الاستضافة المشمولة في باقة المرة الواحدة (شهور)
NEXT_PUBLIC_ONCE_HOSTING_MONTHS=12
# طريقة الدفع تظهر للعميل حتى ربط بوابة دفع (مثال: تحويل بنكي على الآيبان ...)
NEXT_PUBLIC_PAYMENT_NOTE=
# رقم واتساب لاستلام إثبات التحويل (بصيغة دولية بدون +)
NEXT_PUBLIC_WHATSAPP=
# التسجيل بالبريد — https://resend.com (المرسل يجب أن يكون نطاقاً موثقاً عندهم)
RESEND_API_KEY=
MAIL_FROM="اسم المنصة <no-reply@yourdomain.sa>"
# التسجيل بالجوال — Twilio أو Unifonic
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
UNIFONIC_APP_SID=
UNIFONIC_SENDER=
# للتجربة فقط: يعرض رمز التحقق على الشاشة بدل إرساله (لا تتركه مفعّلاً بعد الإطلاق)
OTP_DEV_ECHO=false
# تكلفة تقديرية بالريال لكل عملية (للوحة الإدارة)
COST_AI_LOGO_SAR=0.3
COST_AI_IDENTITY_SAR=0.05
